[TEMPLATE]

# ============================================================
# AD / MONETIZATION ENVIRONMENT VARIABLES
# ============================================================
# These are OPTIONAL. Leave them empty/unset when ads are disabled.
# Set them in .env.local for local dev, or in Cloudflare Pages
# dashboard → Settings → Environment variables for production.

# Google AdSense publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX)
# Get this from https://www.google.com/adsense/
# VITE_ADSENSE_PUBLISHER_ID=""

# Adsterra zone / placement ID
# Get this from https://www.adsterra.com/
# VITE_ADSTERRA_ZONE_ID=""

# ============================================================
# LEGACY (unused in current client-side architecture)
# ============================================================
# GEMINI_API_KEY: Was required for Gemini AI API calls in AI Studio.
# No longer used — all tools run 100% client-side.
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Was used for self-referential links in AI Studio.
# No longer needed — site URL is configured in src/config/site.ts.
# APP_URL="MY_APP_URL"
